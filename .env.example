APP_ENV=development
HTTP_PORT=8080
DATABASE_DSN=postgres://parabeacon:parabeacon-dev@localhost:5432/parabeacon?sslmode=disable
# Optional; leave empty unless Redis is running locally.
REDIS_URL=
JWT_SECRET=replace-me-before-starting
JWT_ISSUER=parabeacon-api
JWT_EXPIRY=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set only the proxy IPs/CIDRs you control when deploying behind a trusted proxy.
TRUSTED_PROXIES=
# APK release files are stored outside the static web root; mount this path persistently in production.
APK_STORAGE_DIR=./data/apks
# Uploaded flight packages are stored by server-generated GUID; mount this path persistently in production.
FLIGHT_LOG_STORAGE_DIR=./data/flights
# Normalized user profile photos are stored by server-generated GUID; mount persistently in production.
PROFILE_IMAGE_STORAGE_DIR=./data/profile-images
APK_PACKAGE_NAME=com.beacon.parabeacon
# Required only to publish a release; generate a unique secret of at least 32 characters and store it in a secret manager.
APK_RELEASE_ADMIN_TOKEN=
